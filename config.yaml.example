# hyphae configuration example
# Copy to config.yaml and adjust values for your environment.
# Set CONFIG_PATH env var to override the default config file location.
# Secrets can also be passed as env vars (see below) to avoid committing them.

# Management REST API
port: "8084"
address: "0.0.0.0"
base_path: "/api/v1"

# Logging
log_level: "info"         # debug | info | warn | error
log_format: "json"        # json | text
log_to_stderr: false
log_to_file: true
log_file_path: "logs/hyphae.log"

# Public HTTPS gateway (reverse proxy to tunnel connections)
public_gateway:
  port: "443"
  tls_cert: "certs/fullchain.pem"    # wildcard TLS certificate
  tls_key: "certs/privkey.pem"
  max_connections: 10000             # max concurrent inbound connections (0 = default 10000)
  read_timeout: "30s"                # initial request read deadline
  write_timeout: "60s"               # response write deadline
  idle_timeout: "60s"                # idle connection timeout

# mTLS tunnel listener (MMA nodes connect here)
tunnel:
  port: "9090"
  ca_cert: "certs/platform-ca.pem"      # CA that signed MMA node client certs
  tls_cert: "certs/tunnel.crt"          # tunnel server certificate (signed by platform CA)
  tls_key: "certs/tunnel.key"           # tunnel server private key
  handshake_timeout: "10s"              # TLS + HTTP upgrade deadline per connection
  max_connections_per_node: 256         # max simultaneous tunnels per node (by cert CN)
  max_total_connections: 1000           # max simultaneous tunnel sessions across all nodes

# Auth0 JWT validation (for the management REST API)
# Override via env vars: HYPHAE_AUTH_DOMAIN, HYPHAE_AUTH_AUDIENCE
auth:
  auth_domain: "your-tenant.auth0.com"
  auth_audience: "https://hyphae.your-domain.com"

# Rate limiting for management API (per client IP)
rate_limiting:
  enabled: true
  requests_per_minute: 60
  burst: 20

# Lease policies
leases:
  max_per_org: 100         # max active leases per org_id (0 = default 100)
  max_ttl_seconds: 86400   # maximum allowed TTL in seconds (0 = default 86400 = 24h)

# Admin Unix socket (used by hyphctl)
admin_socket:
  enabled: true
  socket_path: "/tmp/hyphae_admin.sock"

# Channel relay settings (UNDF-111)
channels:
  enabled: false
  grant_verify_key_path: ""              # path to server_api ES256 public key PEM
  max_idle_seconds: 60                   # max idle time before a channel is closed
  reap_interval: "5s"                    # how often the reaper scans for stale channels
