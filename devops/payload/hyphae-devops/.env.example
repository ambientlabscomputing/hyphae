# Copy this file to .env and fill in real values before running 'make setup'.
# .env is gitignored — never commit it.
#
# The .env file is consumed by:
#   - docker-compose (variable substitution in docker-compose.yaml)
#   - make render-config (envsubst on hyphae/config.yaml.template → hyphae/config.yaml)

# ── Hyphae image mode ────────────────────────────────────────────────────────
# Controls where the hyphae Docker image comes from.
#
#   local    — build from source on your Mac via OrbStack's /mnt/mac mount.
#              Requires HYPHAE_SOURCE_PATH below. Tag will be local-<git-sha>.
#   develop  — pull ambientlabsjose/hyphae:develop from Docker Hub (default).
#   v*       — pull a specific tagged release from Docker Hub (e.g. v1.2.3).
#
HYPHAE_IMAGE_MODE=develop

# Docker Hub image tag — used when HYPHAE_IMAGE_MODE is 'develop' or 'v*'.
# Ignored when HYPHAE_IMAGE_MODE=local (tag is derived from git SHA instead).
HYPHAE_IMAGE_TAG=develop

# ── Local build source (only used when HYPHAE_IMAGE_MODE=local) ──────────────
# Absolute path to the hyphae source directory as visible inside the OrbStack
# VM via the /mnt/mac mount. Adjust if your checkout is in a different location.
HYPHAE_SOURCE_PATH=/mnt/mac/Users/jose/ambient_labs/underleaf/hyphae

# ── TLS certificate directory ─────────────────────────────────────────────────
# Path to the hyphae certs directory as seen inside the OrbStack VM.
# Using /mnt/mac means certs only need to be created once on Mac — no copying.
# Adjust the username segment if your Mac home dir differs.
HYPHAE_CERTS_PATH=/mnt/mac/Users/jose/ambient_labs/underleaf/hyphae/certs

# ── Log directory ─────────────────────────────────────────────────────────────
# Bind-mounted to /var/log/underleaf inside the container. Logs appear directly
# on the Mac at hyphae/logs/hyphae.log without needing to exec into the VM.
HYPHAE_LOGS_PATH=/mnt/mac/Users/jose/ambient_labs/underleaf/hyphae/logs

# ── Auth0 credentials ────────────────────────────────────────────────────────
# Credentials for the shared dev Auth0 machine-to-machine client.
# Used by hyphae to validate management API JWTs.
AUTH0_USERNAME=hyphae
AUTH0_PASSWORD=

# ── Cloudflare Tunnel token ───────────────────────────────────────────────────
# Only required when starting hyphae with the tunnel profile:
#   make run-with-tunnel
# Obtain the token from the Cloudflare Zero Trust dashboard.
CF_TUNNEL_TOKEN=
