# hyphae configuration template
# This file is processed by 'make render-config' which runs envsubst to produce
# hyphae/config.yaml (gitignored). Do not store secrets in this file — use
# placeholders like ${VAR} which are resolved from .env at render time.

# Management REST API
port: "8084"
address: "0.0.0.0"
base_path: "/api/v1"

# Logging
log_level: "debug"         # debug | info | warn | error
log_format: "json"        # json | text
log_to_stderr: true
log_to_file: true
log_file_path: "/var/log/underleaf/hyphae.log"

# Public HTTPS gateway (reverse proxy to tunnel connections)
# tls_cert/tls_key are intentionally empty for local OrbStack dev — the gateway
# falls back to plain HTTP on the configured port. Supply real certs for production.
public_gateway:
  port: "443"
  tls_cert: ""    # leave empty for local dev (plain HTTP fallback)
  tls_key: ""
  max_connections: 10000             # max concurrent inbound connections (0 = default 10000)
  read_timeout: "30s"                # initial request read deadline
  write_timeout: "60s"               # response write deadline
  idle_timeout: "60s"                # idle connection timeout

# mTLS tunnel listener (MMA nodes connect here)
tunnel:
  port: "9090"
  ca_cert: "/etc/underleaf/certs/ca.crt"            # CA that signed MMA node client certs
  tls_cert: "/etc/underleaf/certs/tunnel.crt"        # tunnel server certificate (signed by platform CA)
  tls_key: "/etc/underleaf/certs/tunnel.key"         # tunnel server private key
  handshake_timeout: "10s"              # TLS + HTTP upgrade deadline per connection
  max_connections_per_node: 10          # max simultaneous tunnels per node (by cert CN)
  max_total_connections: 1000           # max simultaneous tunnel sessions across all nodes

# Auth0 JWT validation (for the management REST API)
# Credentials are sourced from .env at render time — never hardcoded here.
auth:
  auth_domain: "dev-motk8gx6wyw7nmbr.us.auth0.com"
  auth_audience: "https://ambientdev.com/v1/api"
  username: "${AUTH0_USERNAME}"
  password: "${AUTH0_PASSWORD}"

# Rate limiting for management API (per client IP)
rate_limiting:
  enabled: true
  requests_per_minute: 60
  burst: 20

# Lease policies
leases:
  max_per_org: 100         # max active leases per org_id (0 = default 100)
  max_ttl_seconds: 86400   # maximum allowed TTL in seconds (0 = default 86400 = 24h)

# Admin Unix socket (used by hyphctl)
admin_socket:
  enabled: true
  socket_path: "/tmp/hyphae_admin.sock"
